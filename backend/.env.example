# =============================================================================
# Library AI — Backend environment variables
# Copy to .env for local dev, or set in Render/Railway dashboard for production.
# =============================================================================

# --- REQUIRED (local + production) ---

# MongoDB Atlas connection string (database name library_db is used automatically)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority

# Secret for signing JWTs — use a long random string in production (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# --- REQUIRED IN PRODUCTION (CORS) ---

# Comma-separated frontend URLs allowed to call this API (no trailing slash)
# Set after Vercel deploy. Example:
# ALLOWED_ORIGINS=https://lib-recc.vercel.app,https://lib-recc-git-main.vercel.app
# ALLOWED_ORIGINS=

# Alternative to ALLOWED_ORIGINS — single frontend URL (also added to CORS)
# FRONTEND_URL=https://lib-recc.vercel.app

# --- OPTIONAL ---

# Pinecone vector DB (required for recommendations)
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=libra-books

# Embedding model used by scripts/sync_pinecone_index.py (384-dim for all-MiniLM-L6-v2)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Production API: skip torch-based encoding on startup/train (run sync script separately)
# SKIP_EMBEDDING_SYNC=true

# Unit tests only — use in-memory vector store instead of Pinecone
# PINECONE_DISABLED=true

# HuggingFace token for AI book suggestions (POST /books/ai-suggest-new)
# Without this, AI suggestions return HTTP 503
# Token needs Inference Providers access: https://huggingface.co/settings/tokens
# HF_API_KEY=
# Optional model override (default: meta-llama/Llama-3.1-8B-Instruct)
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Legacy alias for JWT_SECRET (prefer JWT_SECRET)
# SECRET_KEY=

# Legacy alias for MONGODB_URI (prefer MONGODB_URI)
# MONGO_URI=
