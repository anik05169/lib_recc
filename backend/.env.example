# Required
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
JWT_SECRET=change-me-to-a-long-random-string

# Optional — AI suggestions return empty without this
HF_API_KEY=

# Optional — comma-separated frontend URLs for CORS (required in production)
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Admin: set is_admin: true on a user document in MongoDB for POST /books and POST /train
