# =============================================================================
# Library AI — Backend environment variables
# Copy to .env for local dev, or set in Render/Railway dashboard for production.
# =============================================================================

# --- REQUIRED (local + production) ---

# MongoDB Atlas connection string (database name library_db is used automatically)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority

# Secret for signing JWTs — use a long random string in production (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# --- REQUIRED IN PRODUCTION (CORS) ---

# Comma-separated frontend URLs allowed to call this API (no trailing slash)
# Set after Vercel deploy. Example:
# ALLOWED_ORIGINS=https://lib-recc.vercel.app,https://lib-recc-git-main.vercel.app
# ALLOWED_ORIGINS=

# Alternative to ALLOWED_ORIGINS — single frontend URL (also added to CORS)
# FRONTEND_URL=https://lib-recc.vercel.app

# --- OPTIONAL ---

# HuggingFace token for AI book suggestions (POST /books/ai-suggest-new)
# Without this, AI suggestions return empty with HTTP 503
# HF_API_KEY=

# Legacy alias for JWT_SECRET (prefer JWT_SECRET)
# SECRET_KEY=

# Legacy alias for MONGODB_URI (prefer MONGODB_URI)
# MONGO_URI=
