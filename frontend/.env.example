# =============================================================================
# Library AI — Frontend environment variables
# Copy to .env for local dev, or set in Vercel dashboard BEFORE building.
# Vite bakes VITE_* vars at build time — redeploy after changing them.
# =============================================================================

# --- REQUIRED ---

# Backend API URL (no trailing slash)
# Local:  http://localhost:8000
# Prod:   https://your-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# --- OPTIONAL ---

# Google Books API key — better cover images for AI suggestions (reduces rate limits)
# VITE_GOOGLE_BOOKS_API_KEY=
